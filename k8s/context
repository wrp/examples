


kubectl config current-context # Get the current context
kubectl config get-contexts    # List the available contexts
kubectl config view            # See the available contexts (very verbose)
kubectl config use ${context}  # Use the $context (use == use-context)
kubectl config view | yq -r '.contexts[].name'  # List names of all contexts


# setting the context tweaks a file in the config, so all shells inherit
# the new context by default
kubectl config set-context --current --namespace=${namespace}  # Set the context
