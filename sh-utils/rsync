
# Copy the directory tree at /p/a/t/h (eg, create ./h),
# Unlinking names that do not exist in /p/a/t/h,
# preserving hard links and not preserving timestamps.
$ rsync -rlgpoH --delete /p/a/t/h .

# Copy files in foo to bar.
$ rsync -zva foo/ bar  # foo/baz -> bar/baz)

# Copy the directory foo into bar
$ rsync -zva foo bar  # foo/baz -> bar/foo/baz)

# Copy files in foo to bar, deleting unmatched files in bar
# but keeping bar/file-to-keep  (P == protect)
$ rsync -zva --delete --filter 'P file-to-keep' foo/ bar

# -a is the same as -rlptgoD
#    -r  recurse
#    -l  copy symlinks as symlinks
#    -p  preserve permissions
#    -t  preserve timestamps
#    -g  preserve group
#    -o  preserve owner
#    -D  preserve device files


# Perhaps a more useful set of options is -rlpgoH
#  which won't try to change timestamps and preserves hard links
