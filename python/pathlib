#!/usr/bin/env python

import pathlib
import sys

# pathlib should generally be preferred over os.path

names = ['/', 'tmp', 'foo.bar.baz']

f = pathlib.Path(*names)
full_name = f.absolute()

assert isinstance(full_name, pathlib.PosixPath)
assert str(full_name) == '/tmp/foo.bar.baz', f'full_name = {full_name}'
assert str(full_name.name) == 'foo.bar.baz'
assert str(full_name.stem) == 'foo.bar'
assert str(full_name.suffix) == '.baz', f'suffix = {full_name.suffix}'

assert full_name.suffixes == ['.bar', '.baz'], f'suffixes = {full_name.suffixes}'


a = pathlib.Path('/') / 'foo' / 'bar'
assert(str(a.parent) == '/foo')

a = pathlib.Path('/') / 'dir1' / 'dir2' / 'dir3' / 'dir4'
assert str(a.resolve().parents[0]) == '/dir1/dir2/dir3'
assert str(a.resolve().parents[1]) == '/dir1/dir2'

b = f / a  # Since a is absolute, this is a no-oop
assert b == a

a = f / 'foo' / 'bar'
t = a / 'link_target'
p = a / 'link'

a.mkdir(parents=True, exist_ok=True)

p.unlink(missing_ok=True)
p.symlink_to(t)  # Fails if p exists in the filesystem
