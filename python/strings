#!/usr/bin/env python

# keyword: format string print

s = [
	(f'{"centered":^15}', '   centered    '),
	(f'{"left":<15}',     'left           '),
	(f'{"right":>15}',    '          right'),
	(f'{"neither justified nor truncated":>15}', 'neither justified nor truncated'),
	(f'{"truncated to 5":15.5}', 'trunc          '),
	(f'{"Truncated to 4 characters, centered on width of 20":^20.4}', '        Trun        '),
]
for i, j in s:
    assert i == j, f'\ni = "{i}",\nj = "{j}"'

s = 'a1'
assert s[0].isalnum()
assert not s[0].isdigit()
assert s[1].isalnum()
assert s[1].isdigit()

s = 'this.is.a.string'
assert s.split('.')[0:-1] == ['this', 'is', 'a']
assert '.'.join(s.split('.')[0:-1]) == 'this.is.a'
assert s[0:s.rindex('.')] == 'this.is.a'
