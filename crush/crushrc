#!/usr/bin/env bash

# Put this file in $HOME/.config/crush/crushrc

# Ring the terminal bell when the model finishes a turn
option notifications bell


ANTHROPIC_KEY=$(gpg -qd $HOME/.config/secrets/ANTHROPIC.gpg)
GEMINI_KEY=$(gpg -qd $HOME/.config/secrets/GEMINI_API_KEY.gpg)

provider add anthropic --api-key "$ANTHROPIC_KEY"
model large anthropic/claude-sonnet-4-20250514
model large anthropic/claude-opus-4-8

provider add gemini --api-key "$GEMINI_KEY"
model large gemini/gemini-3.8-flash

provider add openrouter --api-key "$(gpg -qd $HOME/.config/secrets/OPENROUTER_API_KEY.gpg)"
